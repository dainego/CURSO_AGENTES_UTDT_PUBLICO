# Autenticación — elegí UNA de las dos opciones (ver ../../README.md para más detalle)

# Opción A — Google AI Studio (más simple, no requiere gcloud)
# 1. Conseguí una API key gratis en https://aistudio.google.com/apikey
# GOOGLE_API_KEY=tu-api-key
# GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Opción B — Vertex AI con tu cuenta de GCP
# 1. gcloud auth application-default login
# 2. gcloud config set project tu-project-id
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=tu-project-id
GOOGLE_CLOUD_LOCATION=us-central1

GOOGLE_GENAI_MODEL=gemini-2.5-flash
